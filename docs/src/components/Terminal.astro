---
// `supawho use` followed by `supawho whoami`, rendered as a terminal window
// (Supabase palette).
---

<div class="term">
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 386" role="img" aria-label="Terminal: supawho use client-a logs in as that account, then supawho whoami lists each saved account with its email and organization" font-family="'Source Code Pro Variable','Source Code Pro','SF Mono',Menlo,monospace">
		<rect x="1" y="1" width="718" height="384" rx="12" fill="#171717" stroke="#2e2e2e"></rect>
		<path d="M1 13 A12 12 0 0 1 13 1 H707 A12 12 0 0 1 719 13 V38 H1 Z" fill="#1f1f1f"></path>
		<circle cx="26" cy="19" r="6" fill="#ff5f56"></circle>
		<circle cx="46" cy="19" r="6" fill="#ffbd2e"></circle>
		<circle cx="66" cy="19" r="6" fill="#27c93f"></circle>
		<text x="360" y="24" text-anchor="middle" fill="#7e7e7e" font-size="13">supawho</text>
		<line x1="1" y1="38" x2="719" y2="38" stroke="#2e2e2e"></line>
		<g font-size="15">
			<text x="28" y="72"><tspan fill="#3fcf8e" font-weight="bold">$</tspan><tspan fill="#ededed"> supawho use client-a</tspan></text>
			<text x="28" y="98" fill="#707070">Logging in as 'client-a'...</text>
			<text x="28" y="124" fill="#ededed">Logged in as 'client-a'.</text>
			<text x="28" y="158"><tspan fill="#3fcf8e" font-weight="bold">$</tspan><tspan fill="#ededed"> supawho whoami</tspan></text>
			<text x="28" y="184" fill="#707070">Looking up accounts on Supabase...</text>
			<text x="28" y="220" fill="#7e7e7e">ACCOUNT</text>
			<text x="210" y="220" fill="#7e7e7e">EMAIL</text>
			<text x="452" y="220" fill="#7e7e7e">ORGANIZATION</text>
			<text x="28" y="252" fill="#3fcf8e">client-a</text>
			<text x="210" y="252" fill="#ededed">you@example.com</text>
			<text x="452" y="252" fill="#bbbbbb">Client A</text>
			<text x="28" y="282" fill="#3fcf8e">side-project</text>
			<text x="210" y="282" fill="#ededed">you+dev@example.com</text>
			<text x="452" y="282" fill="#bbbbbb">Personal, Labs</text>
			<text x="28" y="312" fill="#3fcf8e">staging</text>
			<text x="210" y="312" fill="#ededed">you+ops@example.com</text>
			<text x="452" y="312" fill="#bbbbbb">Acme Inc</text>
			<text x="28" y="342" fill="#3fcf8e">old-gig</text>
			<text x="210" y="342" fill="#f5555d">(token is invalid or revoked)</text>
			<text x="28" y="372"><tspan fill="#3fcf8e" font-weight="bold">$</tspan><tspan fill="#3fcf8e"> ▋</tspan></text>
		</g>
	</svg>
</div>
